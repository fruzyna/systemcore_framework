{
	"name": "WS WPILib Java",
	"image": "mcr.microsoft.com/devcontainers/base:ubuntu",
	// use the Ubuntu base image with Java as a feature for a newer glibc
	"features": {
		"ghcr.io/devcontainers/features/java": {
			"version": "25",
			"jdkDistro": "ms"
		},
		"./features/wpilib": {},
		"./features/elastic": {}
	},

	"runArgs": [
		// pass all network interfaces through
		"--network=host",
		// fix for devcontainer feature bug with Podman: https://github.com/devcontainers/features/issues/1480
		"--tmpfs=/tmp:rw,exec,nosuid,nodev,mode=1777"
	],

	"customizations": {
		"vscode": {
			// force VS Code / Gradle to look for Java in the right place
			"settings": {
				"java.import.gradle.java.home": "/usr/local/sdkman/candidates/java/current",
				"java.configuration.runtimes": [
					{
						"name": "JavaSE-25",
						"path": "/usr/local/sdkman/candidates/java/current",
						"default": true
					}
				]
			},
			"extensions": [
				"vscjava.vscode-java-pack",
				"davidanson.vscode-markdownlint",
				"streetsidesoftware.code-spell-checker",
				"/tmp/wpilib.vsix"
			]
		}
	}
}
